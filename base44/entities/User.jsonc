{
  "name": "User",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono del usuario"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "owner",
        "renter"
      ],
      "description": "Tipo de usuario: propietario o arrendatario"
    },
    "profile_image": {
      "type": "string",
      "description": "URL de la foto de perfil"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n en Isla de Margarita"
    },
    "bio": {
      "type": "string",
      "description": "Biograf\u00eda corta del usuario"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Si el usuario est\u00e1 verificado"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Si el usuario est\u00e1 suspendido"
    },
    "total_earnings": {
      "type": "number",
      "default": 0,
      "description": "Ganancias totales (para propietarios)"
    },
    "average_rating": {
      "type": "number",
      "default": 0,
      "description": "Calificaci\u00f3n promedio"
    },
    "total_reviews": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero total de rese\u00f1as"
    },
    "notification_preferences": {
      "type": "object",
      "description": "Preferencias de notificaciones del usuario",
      "properties": {
        "booking_updates": {
          "type": "boolean",
          "default": true,
          "description": "Notificaciones de actualizaciones de reservas"
        },
        "chat_messages": {
          "type": "boolean",
          "default": true,
          "description": "Notificaciones de nuevos mensajes"
        },
        "payment_updates": {
          "type": "boolean",
          "default": true,
          "description": "Notificaciones de pagos"
        },
        "promotional": {
          "type": "boolean",
          "default": false,
          "description": "Notificaciones promocionales y ofertas"
        },
        "reminders": {
          "type": "boolean",
          "default": true,
          "description": "Recordatorios de recogida y devoluci\u00f3n"
        },
        "push_enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar notificaciones push del navegador"
        },
        "sound_enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar sonido de notificaciones"
        }
      }
    },
    "calendar_sync_vehicle_id": {
      "type": "string",
      "description": "ID del veh\u00edculo sincronizado con Google Calendar"
    },
    "calendar_auto_sync": {
      "type": "boolean",
      "default": false,
      "description": "Si la sincronizaci\u00f3n autom\u00e1tica est\u00e1 habilitada"
    },
    "calendar_last_sync": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de la \u00faltima sincronizaci\u00f3n"
    }
  },
  "required": []
}