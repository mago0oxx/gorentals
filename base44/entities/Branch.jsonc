{
  "name": "Branch",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la sucursal"
    },
    "city": {
      "type": "string",
      "description": "Ciudad"
    },
    "country": {
      "type": "string",
      "description": "Pa\u00eds"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la sucursal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si la sucursal est\u00e1 activa para reservas"
    },
    "is_coming_soon": {
      "type": "boolean",
      "default": false,
      "description": "Si la sucursal est\u00e1 marcada como pr\u00f3ximamente"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    }
  },
  "required": [
